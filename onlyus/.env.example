# ONLYUS Environment Variables
# Copy to .env.local for local development (never commit real secrets).

# Supabase (Client - Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Firebase (Project: onlyus-2026)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=onlyus-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=onlyus-2026
VITE_FIREBASE_STORAGE_BUCKET=onlyus-2026.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=873044245775
VITE_FIREBASE_APP_ID=your-firebase-app-id

# LiveKit (Client + Server)
VITE_LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit-token

# Optional WebRTC TURN Server (never hardcode credentials)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional GIF Search API
VITE_TENOR_API_KEY=

# Optional Web Push VAPID Public Key
VITE_VAPID_PUBLIC_KEY=

# Server-side Only (Set in Vercel / Supabase Edge Function Secrets)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
VAPID_PRIVATE_KEY=
